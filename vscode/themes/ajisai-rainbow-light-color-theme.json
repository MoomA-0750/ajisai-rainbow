    "statusBar.foreground": "#12404f",
    "statusBar.border": "#a4d3d0",
    "statusBar.noFolderBackground": "#ace3dd",
    "statusBar.debuggingBackground": "#7446b8",
    "statusBar.debuggingForeground": "#ffffff",
