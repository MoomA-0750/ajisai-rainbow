    "terminal.ansiBrightRed": "#c94f80",
    "terminal.ansiGreen": "#1d7f52",
    "terminal.ansiBrightGreen": "#2a8f61",
    "terminal.ansiYellow": "#86700f",
    "terminal.ansiBrightYellow": "#977f1a",
    "terminal.ansiBlue": "#1e63b8",
    "terminal.ansiBrightBlue": "#2f78cc",
    "terminal.ansiMagenta": "#7446b8",
    "terminal.ansiBrightMagenta": "#8559c9",
    "terminal.ansiCyan": "#137a86",
    "terminal.ansiBrightCyan": "#1b8b97",
    "terminal.ansiWhite": "#9cc9c8",
