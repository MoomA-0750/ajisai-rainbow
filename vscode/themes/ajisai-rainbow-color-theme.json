    "editorError.foreground": "#ec8fb4",
    "editorWarning.foreground": "#e6df9a",
    "editorInfo.foreground": "#4aa6f2",
    "editorHint.foreground": "#5cc3cc",
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.errorForeground": "#ec8fb4",
    "editorOverviewRuler.warningForeground": "#e6df9a",
    "editorOverviewRuler.addedForeground": "#5ccf96",
    "editorOverviewRuler.modifiedForeground": "#4aa6f2",
    "editorOverviewRuler.deletedForeground": "#ec8fb4",
    "editorOverviewRuler.findMatchForeground": "#e6df9a",
    "editorBracketHighlight.foreground1": "#d6b8f7",
